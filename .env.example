# Copy this file to .env and adjust as needed:  cp .env.example .env
#
# PokeAPI is a consumption-only, key-free API, so there is NO secret to store here.
# This file exists to show the config pattern the project uses, and so that the same
# code works unchanged on a host like Render where PORT is injected automatically.

# Port the Express server listens on locally. Render overrides this at runtime.
PORT=3001

# Base URL for PokeAPI v2. Change this only if you are pointing at a mirror.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# How long cached PokeAPI responses stay fresh, in seconds. Default is 7 days.
# PokeAPI data is effectively static, so a long TTL is both safe and encouraged
# by their fair use policy.
CACHE_TTL_SECONDS=604800

# Max number of simultaneous requests the server makes to PokeAPI.
# Keep this modest to stay friendly to their servers.
POKEAPI_CONCURRENCY=10
